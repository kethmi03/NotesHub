rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    match /notes/{noteId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}